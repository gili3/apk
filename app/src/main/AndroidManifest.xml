<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ✅ جديد: تحديد الموقع لاختيار عنوان التوصيل على الخريطة -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".ElevenStoreApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElevenStore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ElevenStore.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ElevenFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/accent" />
        <!-- ✅ إصلاح جذري: بدون هذا الـmeta-data، عندما يصل Push والتطبيق
             بالخلفية أو مغلق تماماً (الحالة الأكثر شيوعاً)، لا يستدعي النظام
             onMessageReceived إطلاقاً — بل يحاول عرض الإشعار تلقائياً بنفسه،
             لكن بدون قناة افتراضية محدَّدة ومُنشأة مسبقاً، بعض الأجهزة (خصوصاً
             Android 8+ وأغلب أجهزة شاومي/سامسونج المخصَّصة) تُسقِط الإشعار
             بصمت لعدم وجود قناة صالحة يُرسَل إليها. راجع أيضاً
             ElevenStoreApp.kt حيث تُنشأ هذه القناة فعلياً عند إقلاع التطبيق. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/default_notification_channel_id" />

        <!-- ✅ جديد: مفتاح خرائط جوجل — يُحقن وقت البناء من local.properties/CI
             (نفس نمط أسرار التوقيع وAlgolia، راجع manifestPlaceholders في
             app/build.gradle) — لا يُكتب صراحة هنا أبداً. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

    </application>
</manifest>
